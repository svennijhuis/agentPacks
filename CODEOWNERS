# Ownership. Replace with team handles if this ever moves into an organization.

# Everything has a default owner.
*                           @svennijhuis

# Validation and generation decide what the whole company can ship.
/tools/                     @svennijhuis
/schema/                    @svennijhuis

# Workflow changes affect the trust boundary of the generated files.
/.github/                   @svennijhuis

# MCP servers reach internal systems, so they deserve a second reviewer once there is one.
/plugins/*/mcp.json         @svennijhuis

# External code adoption is a review gate, not a preference.
/plugins/*/external-skills.json  @svennijhuis

# Hooks run code on a developer's machine at moments they did not trigger.
/plugins/*/hooks.source.json     @svennijhuis
/plugins/*/scripts/              @svennijhuis

# Generated. Changes here should only ever arrive from automation.
/.claude-plugin/            @svennijhuis
