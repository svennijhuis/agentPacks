{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT}/scripts/pack-check-session\"",
        "powershell": "Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -ErrorAction SilentlyContinue; & \"${PLUGIN_ROOT}/scripts/pack-check-session.ps1\"",
        "cwd": "${PLUGIN_ROOT}"
      }
    ]
  }
}
