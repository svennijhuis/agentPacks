{
  "hooks": {
    "postToolUse": [
      {
        "matcher": "write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/dotnet-format\" -Matcher \"[.](cs|csx|vb)\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
