{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/dotnet-format\" -Matcher \"[.](cs|csx|vb)\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
