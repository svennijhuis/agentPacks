{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dotnet",
  "version": "0.1.0",
  "description": "Formats a C# file the moment an agent writes it, so the diff a human reviews is already formatted and formatting never turns up as a review finding.",
  "author": {
    "name": "agentPacks Maintainers"
  },
  "license": "UNLICENSED",
  "keywords": [
    "dotnet",
    "csharp",
    "formatting",
    "editorconfig",
    "hooks"
  ],
  "extensions": {
    "com.anthropic.claude-code": {},
    "com.openai.codex": {},
    "com.github.copilot": {}
  }
}
