{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/git-guard\" -Matcher \"git\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/git-guard.ps1\" -Matcher \"git\""
          }
        ]
      }
    ]
  }
}
