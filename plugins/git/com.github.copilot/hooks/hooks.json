{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "bash": "\"${PLUGIN_ROOT}/scripts/git-guard\" -Matcher \"git\"",
        "powershell": "Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -ErrorAction SilentlyContinue; & \"${PLUGIN_ROOT}/scripts/git-guard.ps1\" -Matcher \"git\"",
        "cwd": "${PLUGIN_ROOT}",
        "matcher": "Bash"
      }
    ]
  }
}
