{{~
# One skeleton for every language-pack slot skill. A pack authors
# skills/<lang>-<slot>/SKILL.source.md with the pack-specific facts; the loader renders this
# template around them, and generation writes the result to skills/<lang>-<slot>/SKILL.md on
# the marketplace branch. Variables: name, description, title, language, intro, slot,
# standards (filenames from standards.source.json consumers), examples (label + path),
# has_commands, commands, has_checklist, body.

case slot
  when "build"
    phase = "implement or review"
    default_intro = "The facts an agent needs before it edits " + language + ". Read the repository's own files first; the common layout is not a guarantee."
    cite = "Cite the document filename on each edit (`" + standards[0] + "`, not \"the " + language + " standard\")."
    examples_label = "Examples"
  when "review"
    phase = "review or build"
    default_intro = ""
    cite = "Cite the document filename on each finding (`" + standards[0] + "`, not \"the " + language + " standard\")."
    examples_label = "Finding cites"
  when "test-patterns"
    phase = "implement or verify"
    default_intro = "How a test is written *in this stack*. What deserves a test at all is a separate question, and it is not a " + language + " one."
    cite = "Cite `" + standards[0] + "` when choosing a fixture, boundary, or command."
    examples_label = "Concrete cases"
  else
    phase = "review"
    default_intro = ""
    cite = "Cite the document filename on each finding (`" + standards[0] + "`)."
    examples_label = "Finding cites"
end

lead = intro ? intro : default_intro

standards_list = ""
for s in standards
  if !for.first
    standards_list = standards_list + ", "
  end
  standards_list = standards_list + "`" + s + "`"
end

steps = ["Read every file in `references/standards/`."]
if slot == "test-patterns" && examples.size > 0
  steps = steps | array.add "Read every file in `references/examples/`."
end
steps = steps | array.add ("Standards in force: " + standards_list + ".")
steps = steps | array.add cite

example_links = ""
for e in examples
  if !for.first
    example_links = example_links + ", "
  end
  example_links = example_links + "[" + e.label + "](" + e.path + ")"
end
~}}
---
name: {{ name }}
description: {{ description }}
license: UNLICENSED
user-invocable: false
metadata:
  audience: loop
---

Internal. Do not run directly — Squad loads by exact Skill name.

# {{ title }}

Loop-only; not as a user entrypoint.{{ if lead != "" }} {{ lead }}{{ end }}

When loaded by exact Skill tool name `{{ name }}` during {{ phase }}:
{{~ for step in steps ~}}
{{ for.index + 1 }}. {{ step }}
{{~ end ~}}

{{~ if has_commands ~}}
Read [{{ commands }}](references/commands.md).

{{~ end ~}}
{{~ if examples.size > 0 ~}}
{{ examples_label }}: {{ example_links }}.
{{~ end ~}}
{{~ if has_checklist ~}}
Process findings per [the checklist](references/checklist.md).
{{~ end ~}}
{{~ if examples.size > 0 || has_checklist ~}}

{{~ end ~}}
{{ body }}
