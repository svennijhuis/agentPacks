{
  "name": "agentpacks",
  "owner": {
    "name": "agentPacks Maintainers"
  },
  "description": "Private agentPacks plugins. Generated from the portable Agent Plugins source.",
  "plugins": [
    {
      "name": "dotnet",
      "displayName": ".NET",
      "source": "./plugins/dotnet",
      "description": "The C# and .NET pack: canonical build, implementation, test and review standards consumed by Squad.",
      "author": {
        "name": "agentPacks Maintainers"
      },
      "license": "UNLICENSED",
      "keywords": [
        "dotnet",
        "csharp",
        "language-pack",
        "build",
        "testing",
        "review",
        "editorconfig"
      ],
      "skills": "./skills/",
      "strict": true
    },
    {
      "name": "git",
      "displayName": "Git",
      "source": "./plugins/git",
      "description": "Blocks the git commands that destroy work an agent cannot get back: reset --hard, clean -fd, push --force, branch -D, and checkout or restore over the working tree.",
      "author": {
        "name": "agentPacks Maintainers"
      },
      "license": "UNLICENSED",
      "keywords": [
        "git",
        "guardrails",
        "safety",
        "data-loss",
        "hooks"
      ],
      "strict": true
    },
    {
      "name": "pack-check",
      "displayName": "Pack Check",
      "source": "./plugins/pack-check",
      "description": "Detects the repository stack at session start and offers to install the language pack that supplies its required build and test skills.",
      "author": {
        "name": "agentPacks Maintainers"
      },
      "license": "UNLICENSED",
      "keywords": [
        "stack",
        "detection",
        "language-packs",
        "onboarding"
      ],
      "skills": "./skills/",
      "commands": [
        "./com.anthropic.claude-code/commands/"
      ],
      "strict": true
    },
    {
      "name": "rust",
      "displayName": "Rust",
      "source": "./plugins/rust",
      "description": "The Rust pack: canonical Cargo build, implementation, test and review standards consumed by Squad.",
      "author": {
        "name": "agentPacks Maintainers"
      },
      "license": "UNLICENSED",
      "keywords": [
        "rust",
        "cargo",
        "language-pack",
        "build",
        "testing",
        "review",
        "rustfmt",
        "clippy"
      ],
      "skills": "./skills/",
      "strict": true
    },
    {
      "name": "security",
      "displayName": "Security",
      "source": "./plugins/security",
      "description": "User-invoked /security-audit: recon, parallel hunting, and adversarial validation of exploitable trust-boundary failures. Per-change OWASP stays in Squad.",
      "author": {
        "name": "agentPacks Maintainers"
      },
      "license": "UNLICENSED",
      "keywords": [
        "security",
        "audit",
        "threat-model",
        "vulnerability",
        "agents"
      ],
      "skills": "./skills/",
      "agents": [
        "./com.anthropic.claude-code/agents/security-hunter.md",
        "./com.anthropic.claude-code/agents/security-recon.md",
        "./com.anthropic.claude-code/agents/security-validator.md"
      ],
      "commands": [
        "./com.anthropic.claude-code/commands/"
      ],
      "strict": true
    },
    {
      "name": "squad",
      "displayName": "Squad",
      "source": "./plugins/squad",
      "description": "User-invoked /squad, /squad-review, and /scenarios: the main agent mediates planning, runs plan-bound implementation and verification, fans dual-axis reviewers, and merges at most two fix rounds before an uncommitted hand-off. /scenarios writes docs/smoke/<slug>.md from changed code.",
      "author": {
        "name": "agentPacks Maintainers"
      },
      "license": "UNLICENSED",
      "keywords": [
        "workflow",
        "planning",
        "implementation",
        "testing",
        "review",
        "security",
        "owasp",
        "agents"
      ],
      "skills": "./skills/",
      "agents": [
        "./com.anthropic.claude-code/agents/squad-implementer.md",
        "./com.anthropic.claude-code/agents/squad-orchestrator.md",
        "./com.anthropic.claude-code/agents/squad-planner.md",
        "./com.anthropic.claude-code/agents/squad-reviewer.md",
        "./com.anthropic.claude-code/agents/squad-security-reviewer.md",
        "./com.anthropic.claude-code/agents/squad-simplifier.md",
        "./com.anthropic.claude-code/agents/squad-verifier.md"
      ],
      "commands": [
        "./com.anthropic.claude-code/commands/"
      ],
      "strict": true
    },
    {
      "name": "typescript",
      "displayName": "TypeScript",
      "source": "./plugins/typescript",
      "description": "The TypeScript pack: canonical tsc build, test and review standards consumed by Squad.",
      "author": {
        "name": "agentPacks Maintainers"
      },
      "license": "UNLICENSED",
      "keywords": [
        "typescript",
        "language-pack",
        "build",
        "testing",
        "review"
      ],
      "skills": "./skills/",
      "strict": true
    }
  ]
}
